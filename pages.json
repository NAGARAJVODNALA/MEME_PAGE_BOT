name: Auto Meme Page Publisher

on:
  workflow_dispatch:
  schedule:
    - cron: "0 17 * * *" # Daily at 12:00 PM EST (17:00 UTC)

permissions:
  contents: write

jobs:
  post-meme:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install FFmpeg and Python dependencies
        run: |
          sudo apt-get update && sudo apt-get install -y ffmpeg
          pip install pillow google-genai

      - name: Run meme_agent.py
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          IG_USER_ID: ${{ secrets.IG_USER_ID }}
          IG_ACCESS_TOKEN: ${{ secrets.IG_ACCESS_TOKEN }}
          PUBLISH_TO_IG: "true"
        run: python meme_agent.py
